

//To train in stats where an attribute is changed by a standard number with no other calculations (ex: str + 2)
var trainStats(var npc, var stat_type, var change)
{
	var training_points = UI_get_npc_prop(npc, TRAINING);
	var npc_stat = UI_get_npc_prop(npc, stat_type);

	//if stat plus change is over 30, return training point and set to 30
	if (npc_stat + change >= 30)
	{
		var excess = npc_stat + change - 30; // Calculate excess points
        UI_set_npc_prop(npc, stat_type, 30); // Set stat to the maximum of 30
        training_points += excess; // Return unused training points
        UI_set_npc_prop(npc, TRAINING, training_points); // Update training poin
	
	}
	else
	{
        // Apply the stat change if within limits
        UI_set_npc_prop(npc, stat_type, npc_stat + change);
        UI_set_npc_prop(npc, TRAINING, training_points - change);
    }
	

}


